#!/usr/bin/env bash
#
# Lint staged Elixir files for the color_matching project.
#
# Mirrors the project's `bin/setup-git-hooks` checks so the Paid-installed
# pre-commit hook (which prefers `bin/lint --staged` over `bundle exec rubocop`)
# exercises the project's own formatting pipeline on an Elixir codebase.

set -euo pipefail

export PATH="${HOME}/.local/bin:${PATH}"

prepend_elixir_install_bins() {
  local otp_root="${HOME}/.elixir-install/installs/otp"
  local elixir_root="${HOME}/.elixir-install/installs/elixir"
  local otp_bin=""
  local elixir_bin=""

  if [ -d "${otp_root}" ]; then
    otp_bin="$(find "${otp_root}" -mindepth 2 -maxdepth 2 -type d -name bin | sort -V | tail -n 1)"
  fi

  if [ -d "${elixir_root}" ]; then
    elixir_bin="$(find "${elixir_root}" -mindepth 2 -maxdepth 2 -type d -name bin | sort -V | tail -n 1)"
  fi

  if [ -n "${otp_bin}" ] && [ -n "${elixir_bin}" ]; then
    export PATH="${otp_bin}:${elixir_bin}:${PATH}"
  fi
}

prepend_elixir_install_bins

if command -v mise >/dev/null 2>&1; then
  mix_cmd=(mise exec -- mix)
elif command -v mix >/dev/null 2>&1; then
  mix_cmd=(mix)
else
  echo "Error: neither mix nor mise is available. Install the Elixir toolchain before linting."
  exit 1
fi

run_mix() {
  "${mix_cmd[@]}" "$@"
}

run_mix_test() {
  MIX_ENV=test "${mix_cmd[@]}" test
}

ensure_mix_bootstrap() {
  archives="$(run_mix archive 2>/dev/null || true)"

  if ! printf '%s\n' "${archives}" | grep -q 'hex-'; then
    echo "Installing Hex..."
    run_mix local.hex --force
  fi

  echo "Installing Rebar..."
  run_mix local.rebar --force >/dev/null

  echo "Fetching Mix dependencies..."
  run_mix deps.get >/dev/null
}

ensure_mix_bootstrap

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ex|exs)$' || true)

if [ -n "${1:-}" ] && [ "${1}" = "--staged" ]; then
  if [ -n "${staged_files}" ]; then
    echo "Formatting staged files: ${staged_files}"
    while IFS= read -r file; do
      [ -n "${file}" ] || continue
      run_mix format "${file}"
      git add "${file}"
    done <<EOF
${staged_files}
EOF
  else
    echo "No Elixir files staged to format"
  fi
fi

echo "Verifying mix format on the whole tree..."
run_mix format --check-formatted

echo "Running Credo in strict mode..."
run_mix credo --strict

if [ -n "${1:-}" ] && [ "${1}" = "--staged" ]; then
  echo "Running test suite..."
  run_mix_test
fi
