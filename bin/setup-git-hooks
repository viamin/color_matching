#!/bin/bash
#
# Setup git hooks for the project
#

set -e

echo "Setting up git hooks..."

# Create the pre-commit hook
cat > .git/hooks/pre-commit << 'EOF'
#!/bin/sh
#
# Pre-commit hook to enforce lint and tests before commit.

if [ -x bin/lint ]; then
    echo "Running bin/lint --staged..."
    bin/lint --staged || exit 1
else
    export PATH="${HOME}/.local/bin:${PATH}"

    prepend_elixir_install_bins() {
        otp_root="${HOME}/.elixir-install/installs/otp"
        elixir_root="${HOME}/.elixir-install/installs/elixir"
        otp_bin=""
        elixir_bin=""

        if [ -d "${otp_root}" ]; then
            otp_bin=$(find "${otp_root}" -mindepth 2 -maxdepth 2 -type d -name bin | sort -V | tail -n 1)
        fi

        if [ -d "${elixir_root}" ]; then
            elixir_bin=$(find "${elixir_root}" -mindepth 2 -maxdepth 2 -type d -name bin | sort -V | tail -n 1)
        fi

        if [ -n "${otp_bin}" ] && [ -n "${elixir_bin}" ]; then
            export PATH="${otp_bin}:${elixir_bin}:${PATH}"
        fi
    }

    prepend_elixir_install_bins

    if command -v mix >/dev/null 2>&1; then
        run_mix() {
            mix "$@"
        }
    elif command -v mise >/dev/null 2>&1; then
        run_mix() {
            mise exec -- mix "$@"
        }
    else
        echo "Error: neither mix nor mise is available. Please install Elixir or mise."
        exit 1
    fi

    ensure_mix_bootstrap() {
        archives="$(run_mix archive 2>/dev/null || true)"

        if ! printf '%s\n' "${archives}" | grep -q 'hex-'; then
            echo "Installing Hex..."
            run_mix local.hex --force
        fi

        echo "Installing Rebar..."
        run_mix local.rebar --force >/dev/null

        echo "Fetching Mix dependencies..."
        run_mix deps.get >/dev/null
    }

    ensure_mix_bootstrap

    staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ex|exs)$' || true)

    if [ -n "${staged_files}" ]; then
        echo "Formatting staged Elixir files in fallback..."
        while IFS= read -r file; do
            [ -n "${file}" ] || continue
            run_mix format "${file}"
            git add "${file}"
        done <<STAGED_FILES
${staged_files}
STAGED_FILES
    else
        echo "No staged Elixir files to format in fallback."
    fi

    echo "Running formatter fallback..."
    if ! run_mix format --check-formatted; then
        echo "Error: formatting check failed."
        exit 1
    fi

    echo "Running Credo fallback..."
    if ! run_mix credo; then
        echo "Error: Credo failed."
        exit 1
    fi

    echo "Running test suite fallback..."
    if ! MIX_ENV=test run_mix test; then
        echo "Error: test suite failed."
        exit 1
    fi
fi

exit 0
EOF

# Make the hook executable
chmod +x .git/hooks/pre-commit

echo "✅ Git hooks installed successfully!"
echo ""
echo "The pre-commit hook will now:"
echo "  • Run 'bin/lint --staged' before each commit when available"
echo "  • Fall back to bootstrapped Elixir formatting/tests when bin/lint is unavailable"
echo "  • Reuse mise when mix is not on PATH"
echo ""
echo "Fix hook failures before committing; do not bypass the checks."
